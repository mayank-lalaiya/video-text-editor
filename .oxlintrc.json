{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules", "out", ".vite", "resources"],
  "overrides": [
    {
      "files": ["src/renderer/**/*", "src/shared/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "electron", "**/main/**", "**/preload/**"],
                "message": "Use shared contracts and the narrow desktop bridge; native I/O belongs in main."
              }
            ]
          }
        ]
      }
    }
  ]
}
